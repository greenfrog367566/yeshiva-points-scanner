# Never commit real backup/export files — only sample-backup.json belongs in the repo
backup*.json
*-backup.json
!sample-backup.json

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Local scratch files
*.local.*
notes.txt

# Per-session worktrees — local scratch checkouts, never part of a commit
.claude/worktrees/

# Audit trail of dev servers the reaper hook killed — local history, not shared
.claude/reap-dev-servers.log
