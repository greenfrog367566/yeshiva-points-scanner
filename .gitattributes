# Shell scripts must keep LF endings. core.autocrlf is on for this repo, and a
# .sh checked out with CRLF fails on some bash builds with `$'\r': command not
# found`. Only .claude/hooks/*.sh is affected today; nothing else is touched.
*.sh text eol=lf

# Cloudflare parses _redirects one line at a time, splitting each into
# from / to / status. A CRLF ending leaves a trailing \r glued to the status
# code ("301\r"), which is not a valid status and silently drops the rule.
# The repo already stores LF, so this only guards against a contributor with
# core.autocrlf=false committing CRLF back in.
_redirects text eol=lf
_headers    text eol=lf
robots.txt  text eol=lf
sitemap.xml text eol=lf
