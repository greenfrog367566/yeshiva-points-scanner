# Cloudflare Workers static-asset upload — gitignore-style excludes.
# Without this file, `wrangler deploy` treats the entire repo root (the
# configured assets directory) as content to upload, including node_modules.
# node_modules/workerd/bin/workerd exceeds the 25 MiB per-asset limit, which
# hard-fails every deploy with "Asset too large." See CHANGELOG.
node_modules/
functions/node_modules/
.git/
.wrangler/
.github/
.claude/
